{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        "$peer": {
          ".write": "auth != null && $peer.beginsWith(auth.uid + '_')",
          ".validate": "newData.child('j').isString() && newData.child('j').val().length < 6000"
        }
      }
    },
    "cards": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('p').child(auth.uid).exists() || newData.child('p').child(auth.uid).exists())",
        ".validate": "newData.child('j').isString() && newData.child('j').val().length < 60000"
      }
    },
    "mine": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$code": {
          ".write": "auth != null",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "moves": {
      "$code": {
        ".read": "auth != null",
        ".indexOn": ["s"],
        "$id": {
          ".write": "auth != null && root.child('cards').child($code).child('p').child(auth.uid).exists() && (!data.exists() || !newData.exists() || data.child('j').val() === newData.child('j').val())",
          ".validate": "newData.child('by').val() === auth.uid && newData.child('s').isNumber() && newData.child('j').isString() && newData.child('j').val().length < 20000"
        }
      }
    },
    "state": {
      "$code": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && root.child('cards').child($code).child('p').child(auth.uid).exists()",
          ".validate": "newData.child('j').isString() && newData.child('j').val().length < 400000"
        }
      }
    },
    "kits": {
      "$code": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && root.child('cards').child($code).child('p').child(auth.uid).exists()))",
          ".validate": "newData.child('j').isString() && newData.child('j').val().length < 4000"
        }
      }
    },
    "lock": {
      "$code": {
        ".read": "auth != null",
        "$name": {
          ".write": "auth != null && root.child('cards').child($code).exists()",
          ".validate": "newData.child('h').isString() && newData.child('exp').isNumber()"
        }
      }
    }
  }
}
